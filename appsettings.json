{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SmtpServer": {
    "Port": 25,
    "MaxMessageSize": 10485760,
    "AllowedClients": [
      "127.0.0.1",
      "::1"
    ]
  },
  "GraphApi": {
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "ClientSecret": "your-client-secret",
    "SendFromAddress": "noreply@yourdomain.com",
    "AllowedSenders": []
  }
}
